[Unit]
Description=z13helper - GTK4 control panel
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=%h/.local/bin/z13helper
Environment=Z13HELPER_START_HIDDEN=1
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
# Some gamescope-session implementations export display variables here for
# user services. The file is optional; z13helper can also identify an
# unambiguous primary Gamescope Xwayland server in a Gamescope session.
EnvironmentFile=-%t/gamescope-environment
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical-session.target
