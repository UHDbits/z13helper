[Unit]
Description=z13helper hardware control daemon
Documentation=https://github.com/UHDbits/z13helper#readme
ConditionPathExists=/sys/class/dmi/id/product_name
After=systemd-sysusers.service
StartLimitIntervalSec=60s
StartLimitBurst=5

[Service]
Type=simple
User=root
Group=z13helper
ExecStart=/usr/libexec/z13helperd
RuntimeDirectory=z13helper
RuntimeDirectoryMode=0750
StateDirectory=z13helper
StateDirectoryMode=0750
UMask=0077
Restart=on-failure
RestartSec=1s
TimeoutStopSec=5s
KillSignal=SIGTERM
ExecStopPost=/usr/libexec/z13helperd --release-ec

# The EC mailbox requires raw x86 port I/O via ioperm(2). Do not set
# PrivateDevices=yes — that drops CAP_SYS_RAWIO effectiveness for port I/O.
# CAP_BPF + CAP_PERFMON are used only for the narrow, attached BPF LSM program
# that temporarily returns EAGAIN for Steam-family hidraw reads in Gamescope.
CapabilityBoundingSet=CAP_SYS_RAWIO CAP_BPF CAP_PERFMON
AmbientCapabilities=CAP_SYS_RAWIO CAP_BPF CAP_PERFMON
NoNewPrivileges=yes
DevicePolicy=closed
DeviceAllow=char-hidraw rw
DeviceAllow=char-input r

PrivateNetwork=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectHostname=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
# ProtectKernelTunables remounts the sysfs superblock read-only. A nested
# ReadWritePaths bind cannot undo that superblock flag, so use explicit
# read-only mounts and grant only the hardware endpoints below.
ProtectKernelTunables=no
# Steam hidraw suppression walks /proc for the Steam process tree and the
# hidraw major. Keeping other processes and /proc/devices visible is required
# so DualSense/Switch hidraw reads can be blocked for Steam.
ReadOnlyPaths=/sys -/proc/sys -/proc/sysrq-trigger -/proc/latency_stats
ReadOnlyPaths=-/proc/acpi -/proc/timer_stats -/proc/fs -/proc/irq
InaccessiblePaths=-/proc/kallsyms -/proc/kcore
ReadWritePaths=/run/z13helper /var/lib/z13helper
# /sys/class entries are symlinks, so grant the resolved GZ302EA backends
# instead of relying on writable-looking class directories.
ReadWritePaths=-/sys/devices/platform/AMDI0105:00/platform-profile
ReadWritePaths=-/sys/devices/platform/asus-nb-wmi
ReadWritePaths=-/sys/firmware/acpi/platform_profile
ReadWritePaths=-/sys/class/power_supply/BAT0/charge_control_end_threshold
ReadWritePaths=-/sys/class/power_supply/BAT1/charge_control_end_threshold
ReadWritePaths=-/sys/devices/virtual/firmware-attributes/asus-armoury
ReadWritePaths=-/sys/kernel/ryzen_smu_drv
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
# libbpf loads the hidraw LSM program through bpf(2); MDWE breaks that path.
MemoryDenyWriteExecute=no
# CAP_SYS_RESOURCE is intentionally not granted; raise the memlock ceiling here
# so BPF map/program creation cannot fail on RLIMIT_MEMLOCK.
LimitMEMLOCK=infinity
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
